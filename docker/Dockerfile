# Derived image that bakes the NVIDIA/GL runtime fixes into the layer,
# so containers no longer need manual repair after each (re)create.
#
# Build:
#   docker build -f docker/Dockerfile -t sam3d_gs:v0.1-fixed .
#
# The base is the prebuilt sam3d_gs image (pinned by digest to match
# docker-compose.web.yml). Update ARG BASE_IMAGE if the base is bumped.
ARG BASE_IMAGE=crpi-3nfi31esiwp28zns.cn-hangzhou.personal.cr.aliyuncs.com/open_projects_yuchi/sam3d_gs:v0.1@sha256:81522e9bc03f7fc01d952ed1b8d64aada0634041a731cc0af7402a9a8c828ba8
FROM ${BASE_IMAGE}

# Install the repair script both as a build-time step (fixes static files
# like the empty EGL vendor json) and as an NVIDIA entrypoint hook. The
# forward-compat ld.so.conf.d entry is regenerated by the NVIDIA container
# runtime on every start, so it MUST be re-removed at runtime — the base
# image's /opt/nvidia/nvidia_entrypoint.sh *sources* every *.sh in
# /opt/nvidia/entrypoint.d in order, and 99- runs after that entry exists.
# Because the hook is sourced (not exec'd), it must NOT set -eu / exit in
# the parent shell; the wrapper runs the real script in a subshell instead.
COPY docker/nvidia_fixes.sh /usr/local/bin/nvidia_fixes.sh
RUN chmod +x /usr/local/bin/nvidia_fixes.sh \
    && /usr/local/bin/nvidia_fixes.sh \
    && printf '%s\n' '# sourced by nvidia_entrypoint.sh; run fixes in a subshell' \
       'bash /usr/local/bin/nvidia_fixes.sh || true' \
       > /opt/nvidia/entrypoint.d/99-nvidia-fixes.sh
